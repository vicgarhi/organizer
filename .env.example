# Generate a local .env with: python3 scripts/configure_deploy.py --mode http
# Defaults: HTTP on your LXC's IP, LAN only. No router port forwarding.
COMPOSE_PROJECT_NAME=enorden
APP_ADDRESS=:80
CADDY_CONFIG=deploy/Caddyfile
HTTP_PORT=80
HTTPS_PORT=443
COOKIE_SECURE=false
# Optional fixed password. If omitted, first startup generates a private password
# in the persistent volume: /data/initial-password.txt (see deployment guide).
# APP_PASSWORD=
# Optional AI credentials (server-side only):
# OPENAI_API_KEY=
AI_MODEL=gpt-4.1-mini
# Optional Web Push identity (generate after startup, see deployment guide):
# VAPID_PRIVATE_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# true only with prepared Linux/Python 3.12 wheel files + SHA256SUMS in deploy/wheels
INSTALL_OFFLINE=false
